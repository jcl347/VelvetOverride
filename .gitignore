# Secrets
.env
config/.env

# Personal data — real profile/answers live in *.local.yaml (gitignored).
# The committed profile.yaml / answers.yaml are safe placeholders.
config/*.local.yaml

# Your own resume dropped in the repo root (contains name/phone/email/history).
# Referenced via resume.static_resume_path; never commit it.
/*.pdf
/*.docx
/*.doc

# Generated data (DB, tailored resumes, exports, logs — all runtime artifacts)
data/
data/applications.db
data/resumes/
data/*.csv
data/*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Browser data
browser_data/
user_data_dir/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Screenshots
screenshots/

# Logs
*.log
logs/
