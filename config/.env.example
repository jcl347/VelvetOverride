# LinkedIn credentials
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password_here

# ── LLM provider ──
# OpenAI (ChatGPT) is the default provider.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Anthropic Claude (only used if llm.provider: anthropic in settings.yaml)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: CAPTCHA solving API key (2Captcha or CapSolver)
# CAPTCHA_API_KEY=your_captcha_api_key_here

# Optional: proxy configuration
# PROXY_URL=http://user:pass@proxy-host:port
